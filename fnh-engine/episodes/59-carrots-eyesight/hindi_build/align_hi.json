{
"lines": {
"i1": {
"start": 0.0,
"end": 2.56,
"text": "Do you know if eating carrots can actually make you see better?"
},
"i2": {
"start": 2.86,
"end": 9.8,
"text": "Your mom says yes, even in the dark. But that story started as a wartime cover-up."
},
"a1": {
"start": 10.38,
"end": 14.1,
"text": "In nineteen-forty, British pilots kept shooting down planes at night."
},
"a1q": {
"start": 14.16,
"end": 18.38,
"text": "And the papers said, they eat loads of carrots!"
},
"a2": {
"start": 18.96,
"end": 23.5,
"text": "The real secret was a brand-new radar in the plane. The carrots? Just a cover story."
},
"b1": {
"start": 24.1,
"end": 31.22,
"text": "Carrots do help a bit. Your body turns them into vitamin A, and your eyes need it to see in dim light."
},
"b2": {
"start": 31.86,
"end": 37.6,
"text": "But extra carrots won't give you night vision. They only help if you're short on vitamin A."
},
"c1": {
"start": 38.38,
"end": 42.38,
"text": "And if things still look blurry, carrots won't fix that. It's time to get your eyes checked."
},
"c2": {
"start": 43.2,
"end": 48.96,
"text": "Send this to the mom who still says, eat your carrots, you'll see in the dark!"
}
},
