# Voice settings used by make_vo.py for every episode (export before running it; build_ep.sh does this).
# A = current approved voice (Kokoro 75% am_eric + 25% am_fenrir, lifted register 165 Hz, expressive prosody).
# Change only via improvements.md (log the change) or when the owner picks another option.
VOICES=am_eric:0.75,am_fenrir:0.25
GT=165
EXS=0.5
BMP=0.8
